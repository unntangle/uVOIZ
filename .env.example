# ============================================
# uVOIZ — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================

# --- SUPABASE (Required) ---
# Get these from supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# --- JWT Secret (Required) ---
# Any random long string — used to sign session tokens
# Generate one: https://generate-secret.vercel.app/64
JWT_SECRET=your_random_64_char_secret_here

# --- VAPI Voice AI (Required for real calls) ---
# Get from vapi.ai → Dashboard → API Keys
VAPI_API_KEY=your_vapi_key_here
VAPI_PHONE_NUMBER_ID=your_phone_number_id

# --- OpenAI (Required for AI conversations) ---
# Get from platform.openai.com → API Keys
OPENAI_API_KEY=sk-your_key_here

# --- ElevenLabs (Required for voice) ---
# Get from elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=your_elevenlabs_key

# --- Deepgram (Required for speech-to-text) ---
# Get from deepgram.com → Dashboard → API Keys
DEEPGRAM_API_KEY=your_deepgram_key

# --- Exotel (Required for Indian telephony) ---
# Get from exotel.com → Settings → API
EXOTEL_API_KEY=your_exotel_key
EXOTEL_API_TOKEN=your_exotel_token
EXOTEL_SUBDOMAIN=your_company
EXOTEL_CALLER_ID=+919090909090

# --- Cashfree Payments (Required for billing) ---
# Get from merchant.cashfree.com → Developers → API Keys
# Use the Sandbox keys for local dev/testing, Production keys for live.
# CASHFREE_ENV controls which Cashfree base URL the server hits AND which
# JS SDK mode the client opens. Keep it in sync with the keys you set.
CASHFREE_ENV=sandbox            # 'sandbox' or 'production'
CASHFREE_APP_ID=your_app_id
CASHFREE_SECRET_KEY=your_secret_key

# --- Cloudflare R2 (Required for call recording storage) ---
# Get from Cloudflare dashboard → R2 → Manage API Tokens.
# Account ID is in the right sidebar of the R2 home page.
# Permissions on the token: "Object Read & Write" scoped to the bucket below.
# R2 has zero egress fees — critical for an audio product where QA reviewers
# replay recordings. Free tier covers 10 GB storage + 10M reads/month.
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your_r2_bucket_name
# Optional. Only used if you front R2 with a custom domain via Cloudflare's
# "Public access" → "Custom domain". For recordings we use signed URLs
# instead, so this stays empty in most setups.
R2_PUBLIC_URL=

# --- App URL ---
# Used for Cashfree return_url and notify_url. Must be reachable by
# Cashfree for webhooks — for local dev, expose via ngrok/cloudflared.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# --- Cron auth (Required for dialer + retention jobs) ---
# Bearer token that protects /api/cron/* and any retention/cleanup routes.
# Vercel Cron and GitHub Actions both send this as the Authorization header.
# Generate one: openssl rand -hex 32   (or any random 32+ char string)
CRON_SECRET=your_random_cron_secret

# --- Resend (Required for transactional email) ---
# Get from resend.com → API Keys. Permissions: Sending access only.
# RESEND_FROM_EMAIL must be on a domain you've verified at resend.com.
RESEND_API_KEY=re_your_resend_key
RESEND_FROM_EMAIL=noreply@uvoiz.unntangle.com

# --- Super Admin (Unntangle staff) ---
# Bootstrap credentials for /console access before any DB users exist.
# Once you create a real user in Supabase with role='super_admin', these become unnecessary.
# IMPORTANT: Never commit real values to version control.
# DEPRECATED: These vars are no longer read anywhere in code. Create a real
# super_admin user in Supabase instead:
#   1. Sign up at /sign-up with the desired email
#   2. In Supabase SQL Editor:  UPDATE users SET role='super_admin' WHERE email='...';
# SUPER_ADMIN_EMAIL=
# SUPER_ADMIN_PASSWORD=
